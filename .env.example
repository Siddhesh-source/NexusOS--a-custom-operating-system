# Copy to .env and set absolute tool paths (Windows example).
# On Linux/WSL you usually do NOT need a .env file — tools are on PATH.

BHARAT_CLANG=C:\Program Files\LLVM\bin\clang.exe
BHARAT_LLD=C:\Program Files\LLVM\bin\ld.lld.exe
BHARAT_OBJCOPY=C:\Program Files\LLVM\bin\llvm-objcopy.exe
BHARAT_NASM=C:\Tools\NASM\nasm.exe
BHARAT_QEMU=D:\qemu\qemu-system-x86_64.exe
BHARAT_OVMF_CODE=D:\qemu\share\edk2-x86_64-code.fd
BHARAT_OVMF_VARS=D:\qemu\share\edk2-i386-vars.fd
